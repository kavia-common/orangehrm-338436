# OrangeHRM Cucumber Test Suite - Environment Variables
# Copy this file to .env and update the values as needed.

# Base URL of the OrangeHRM application under test
# ORANGEHRM_BASE_URL=http://localhost:8080

# Default login credentials for test execution
# ORANGEHRM_USERNAME=Admin
# ORANGEHRM_PASSWORD=admin123

# Browser selection: chrome | firefox
# browser=chrome

# Run browser in headless mode (recommended for CI)
# headless=true
