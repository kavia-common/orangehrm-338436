# ============================================================
# OrangeHRM Application -- Environment Variables
# ============================================================
# Copy this file to .env and adjust values for your environment.
# These variables configure the PHP application (Conf.php),
# PHPUnit tests, and the Selenium-Cucumber test suite.
# ============================================================

# --- Database Configuration (PHP Application & PHPUnit) ---
# Used by lib/confs/Conf.php to connect via Doctrine ORM.
# Defaults (if not set): localhost / 3306 / orangehrm / orangehrm / orangehrm
ORANGEHRM_DB_HOST=localhost
ORANGEHRM_DB_PORT=3306
ORANGEHRM_DB_NAME=orangehrm
ORANGEHRM_DB_USER=orangehrm
ORANGEHRM_DB_PASSWORD=orangehrm

# --- Selenium-Cucumber Test Database (Java/JDBC) ---
# Used by src/test/selenium-cucumber ConfigManager / DatabaseUtil.
# These map to db.url / db.username / db.password / db.driver keys.
# DB_URL=jdbc:mysql://localhost:3306/orangehrm?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=orangehrm
# DB_PASSWORD=orangehrm
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# --- Application URLs (Kavia platform) ---
# BACKEND_URL=https://your-backend-host:3001
# FRONTEND_URL=https://your-frontend-host:3000
# SITE_URL=https://your-frontend-host:3000
