# ============================================================
# OrangeHRM Selenium Test Suite -- Environment Variables
# ============================================================
# Copy this file to .env and fill in the values for your
# environment, or export these variables in your shell / CI.
#
# These variables override values from config.properties and
# any environment-specific overlay file.
# ============================================================

# Active environment profile: dev | qa | staging | production
# TEST_ENVIRONMENT=qa

# --- Application Under Test ---
# BASE_URL=https://your-orangehrm-instance.example.com

# --- Browser Configuration ---
# BROWSER=chrome
# BROWSER_HEADLESS=true

# --- Admin Credentials ---
# ADMIN_USERNAME=Admin
# ADMIN_PASSWORD=<your-admin-password>

# --- ESS User Credentials ---
# ESS_USERNAME=<ess-user>
# ESS_PASSWORD=<ess-password>

# --- Database Configuration (optional, required for @database tagged tests) ---
# OrangeHRM uses MySQL/MariaDB. Configure per environment:
# DB_URL=jdbc:mysql://localhost:3306/orangehrm?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=orangehrm_user
# DB_PASSWORD=<db-password>
# DB_DRIVER=com.mysql.cj.jdbc.Driver
#
# For MariaDB deployments, use instead:
# DB_URL=jdbc:mariadb://localhost:3306/orangehrm?useSSL=false&serverTimezone=UTC
# DB_DRIVER=org.mariadb.jdbc.Driver

# --- Timeouts (seconds) ---
# WAIT_IMPLICIT=5
# WAIT_EXPLICIT=15
# WAIT_PAGELOAD=30
