<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.orangehrm</groupId>
    <artifactId>orangehrm-selenium-cucumber</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>OrangeHRM Selenium Cucumber Tests</name>
    <description>Cucumber + Selenium WebDriver BDD test suite for OrangeHRM application</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <selenium.version>4.18.1</selenium.version>
        <cucumber.version>7.15.0</cucumber.version>
        <junit.version>4.13.2</junit.version>
        <webdrivermanager.version>5.7.0</webdrivermanager.version>
        <slf4j.version>2.0.12</slf4j.version>
        <logback.version>1.5.3</logback.version>

        <!-- Default values; overridden by profiles or CLI -->
        <test.environment>dev</test.environment>
        <browser>chrome</browser>
        <headless>true</headless>
        <baseUrl></baseUrl>

        <!--
            Parallel execution defaults.
            forkCount: number of JVM forks for parallel execution.
              - Use "1" for sequential (default, safest).
              - Use "2" or "0.5C" (half of available cores) for parallel.
            reuseForks: whether to reuse forked JVMs across test classes.
              - "true" reuses (faster startup, but shared JVM state).
              - "false" creates fresh JVMs (safer isolation, slower).
            Override: mvn test -DforkCount=2 -DreuseForks=true
        -->
        <forkCount>1</forkCount>
        <reuseForks>true</reuseForks>

        <!--
            Cucumber parallel execution toggle.
            Set to "true" to enable thread-per-scenario parallelism.
            Set to "false" for fully sequential execution.
            Override: mvn test -Dcucumber.execution.parallel.enabled=false
        -->
        <cucumber.parallel.enabled>true</cucumber.parallel.enabled>
        <cucumber.parallel.threads>2</cucumber.parallel.threads>
    </properties>

    <dependencies>
        <!-- Selenium WebDriver -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- WebDriverManager for automatic driver management -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>

        <!-- Cucumber -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit</artifactId>
            <version>${cucumber.version}</version>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <version>${cucumber.version}</version>
        </dependency>

        <!-- JUnit 4 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- MySQL JDBC Driver (OrangeHRM uses MySQL/MariaDB) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
        </dependency>

        <!-- MariaDB JDBC Driver (alternative for MariaDB deployments) -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.3.3</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

            <!--
                Surefire Plugin for running Cucumber tests.

                Flow name: SurefireParallelExecutionFlow

                Execution strategy:
                  1. TestRunner runs FIRST — executes UI scenarios in parallel
                     (via Cucumber-native thread-per-scenario parallelism).
                  2. SequentialTestRunner runs SECOND — executes @sequential
                     DB scenarios one-at-a-time with parallel disabled.

                Both runners use the same JVM fork. Thread-based parallelism
                is managed by Cucumber, not Surefire fork-based parallelism.
                This avoids the overhead of launching multiple JVMs while
                still achieving scenario-level parallelism.

                Override: mvn test -Dcucumber.parallel.enabled=false (sequential)
                          mvn test -Dcucumber.parallel.threads=4 (more threads)
                          mvn test -DforkCount=2 (JVM-level parallelism)
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/TestRunner.java</include>
                        <include>**/SequentialTestRunner.java</include>
                    </includes>
                    <!--
                        Run test classes sequentially within each fork.
                        TestRunner (parallel scenarios) runs first, then
                        SequentialTestRunner (DB scenarios) runs after.
                        Parallelism WITHIN TestRunner is handled by Cucumber threads.
                    -->
                    <runOrder>alphabetical</runOrder>
                    <!--
                        JVM fork configuration.
                        Default: 1 fork (Cucumber handles parallelism via threads).
                        For extra parallelism: mvn test -DforkCount=2
                    -->
                    <forkCount>${forkCount}</forkCount>
                    <reuseForks>${reuseForks}</reuseForks>
                    <!--
                        Pass Maven properties as JVM system properties so that
                        ConfigManager can read them via System.getProperty()
                        and Cucumber can read parallel settings.
                        Usage examples:
                          mvn test -Dtest.environment=qa
                          mvn test -Dbrowser=firefox -Dheadless=false
                          mvn test -DbaseUrl=https://my-qa-server.example.com
                          mvn test -DforkCount=2 (JVM-level parallelism)
                          mvn test -Dcucumber.parallel.enabled=false (sequential mode)
                          mvn test -Dcucumber.parallel.threads=4 (more parallel threads)
                    -->
                    <systemPropertyVariables>
                        <test.environment>${test.environment}</test.environment>
                        <browser>${browser}</browser>
                        <headless>${headless}</headless>
                        <baseUrl>${baseUrl}</baseUrl>
                        <!-- Cucumber parallel execution settings -->
                        <cucumber.execution.parallel.enabled>${cucumber.parallel.enabled}</cucumber.execution.parallel.enabled>
                        <cucumber.execution.parallel.config.strategy>fixed</cucumber.execution.parallel.config.strategy>
                        <cucumber.execution.parallel.config.fixed.parallelism>${cucumber.parallel.threads}</cucumber.execution.parallel.config.fixed.parallelism>
                        <cucumber.execution.parallel.config.fixed.max-pool-size>8</cucumber.execution.parallel.config.fixed.max-pool-size>
                    </systemPropertyVariables>
                    <!-- Ensure each fork writes to separate report files -->
                    <reportFormat>plain</reportFormat>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- === Environment profiles === -->

        <!-- QA environment -->
        <profile>
            <id>qa</id>
            <properties>
                <test.environment>qa</test.environment>
            </properties>
        </profile>

        <!-- Staging environment -->
        <profile>
            <id>staging</id>
            <properties>
                <test.environment>staging</test.environment>
            </properties>
        </profile>

        <!-- Production environment (smoke tests only) -->
        <profile>
            <id>production</id>
            <properties>
                <test.environment>production</test.environment>
            </properties>
        </profile>

        <!-- === Browser mode profiles === -->

        <!-- Headless profile (default for CI) -->
        <profile>
            <id>headless</id>
            <properties>
                <headless>true</headless>
            </properties>
        </profile>

        <!-- Non-headless profile for local debugging -->
        <profile>
            <id>headed</id>
            <properties>
                <headless>false</headless>
            </properties>
        </profile>

        <!-- Firefox browser profile -->
        <profile>
            <id>firefox</id>
            <properties>
                <browser>firefox</browser>
            </properties>
        </profile>

        <!-- === Test suite profiles === -->

        <!-- Smoke test profile -->
        <profile>
            <id>smoke</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration>
                            <includes>
                                <include>**/SmokeTestRunner.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Regression test profile -->
        <profile>
            <id>regression</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration>
                            <includes>
                                <include>**/RegressionTestRunner.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            === Parallel execution profile ===
            Activates Cucumber thread-based parallelism with more threads.
            Usage: mvn test -Pparallel
            Customise: mvn test -Pparallel -Dcucumber.parallel.threads=4
        -->
        <profile>
            <id>parallel</id>
            <properties>
                <cucumber.parallel.enabled>true</cucumber.parallel.enabled>
                <cucumber.parallel.threads>4</cucumber.parallel.threads>
                <forkCount>1</forkCount>
                <reuseForks>true</reuseForks>
            </properties>
        </profile>

        <!--
            === High-parallelism profile (CI with many cores) ===
            Uses both Cucumber thread parallelism and JVM forks.
            Usage: mvn test -Pparallel-ci
        -->
        <profile>
            <id>parallel-ci</id>
            <properties>
                <cucumber.parallel.enabled>true</cucumber.parallel.enabled>
                <cucumber.parallel.threads>4</cucumber.parallel.threads>
                <forkCount>0.5C</forkCount>
                <reuseForks>true</reuseForks>
            </properties>
        </profile>

        <!--
            === Sequential execution profile ===
            Disables all parallelism for debugging or flaky test investigation.
            Usage: mvn test -Psequential
        -->
        <profile>
            <id>sequential</id>
            <properties>
                <cucumber.parallel.enabled>false</cucumber.parallel.enabled>
                <cucumber.parallel.threads>1</cucumber.parallel.threads>
                <forkCount>1</forkCount>
                <reuseForks>true</reuseForks>
            </properties>
        </profile>
    </profiles>
</project>
